{
  "rules": {
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "visits": {
      ".read": true,
      ".write": true
    },
    "leaderboard": {
      ".read": true,
      "players": {
        "$uid": {
          ".write": "auth != null && auth.uid === $uid"
        }
      },
      "ghosts": {
        "$uid": {
          ".write": "auth != null && auth.uid === $uid"
        }
      },
      "community_benchmarks": {
        ".write": "auth != null"
      }
    }
  }
}
